# --- Onboarding banner ---
#: finance/context_processors.py:71
msgid "Welcome! Let’s get you set up. First, check your categories, edit or add what you need."
msgstr "Sveiki! Pradekime nuo paruosimo. Pirmiausia perziurekite kategorijas, pakoreguokite arba pridekite, ko reikia."

#: finance/context_processors.py:72
msgid "Open Categories"
msgstr "Atidaryti kategorijas"

#: finance/context_processors.py:83
msgid "Next: Upload a CSV file from your bank of your transactions to begin."
msgstr "Kitas žingsnis: įkelkite banko operacijų CSV failą, kad pradėtumėte."

#: finance/context_processors.py:84
msgid "Go to Upload"
msgstr "Eiti į įkėlimą"

#: finance/context_processors.py:95
msgid "Now set a manual balance snapshot so we have a reference point for balances."
msgstr "Dabar nustatykite rankini likucio momentini irasa, kad turetume atskaitos taska likuciams."

msgid "Now enter the current balance in your account so the app can perform calculations."
msgstr "Dabar įrašykite esamą balansą jūsų sąskaitoje, kad aplikacija galėtų atlikti skaičiavimus."

#: finance/context_processors.py:96
msgid "Set a Balance"
msgstr "Nustatyti likutį"

#: finance/context_processors.py:108
#, python-format
msgid ""
"Almost there! Please label at least %(min)s transactions so AI can learn "
"your habits. You’ve labeled %(count)s so far."
msgstr ""
"Jau beveik! Pažymėkite bent %(min)s operacijų, kad AI išmoktų jūsų įpročius. "
"Šiuo metu pažymėjote %(count)s."

#: finance/context_processors.py:111 finance/templates/teach_ai.html:3
#: finance/templates/teach_ai.html:7
msgid "Teach AI"
msgstr "Mokyti AI"

#: finance/context_processors.py:121
msgid "You're ready to auto-categorize. Keep an eye on AI results and correct anything — it will keep improving!"
msgstr "Viskas paruosta automatiniam kategorizavimui. Stebekite AI rezultatus ir prireikus pakoreguokite - taip jis vis geres!"

